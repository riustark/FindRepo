{
  "info": {
    "_postman_id": "b3e9b251-5b92-4112-9c1d-872f2e71d3e8",
    "name": "GitHub Searcher API",
    "description": "Postman collection featuring the 2 core assignment APIs: Search GitHub repositories (POST) and Retrieve stored repositories from PostgreSQL (GET).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://findrepo-production.up.railway.app",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Search GitHub Repositories (POST /api/github/search)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"spring-boot\",\n  \"language\": \"Java\",\n  \"minStars\": 5000,\n  \"sort\": \"stars\",\n  \"order\": \"desc\",\n  \"page\": 1,\n  \"perPage\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/github/search",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "github",
            "search"
          ]
        },
        "description": "1. Searches GitHub API based on query criteria, persists results to PostgreSQL without duplicates (upsert), and returns saved repositories."
      },
      "response": []
    },
    {
      "name": "2. Get Stored Repositories (GET /api/github/repositories)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/github/repositories?language=Java&minStars=1000&sort=stars&direction=DESC&page=0&size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "github",
            "repositories"
          ],
          "query": [
            {
              "key": "language",
              "value": "Java",
              "description": "Optional: Filter by programming language"
            },
            {
              "key": "minStars",
              "value": "1000",
              "description": "Optional: Filter by minimum star count"
            },
            {
              "key": "search",
              "value": "",
              "disabled": true,
              "description": "Optional: Keyword search in name/description"
            },
            {
              "key": "sort",
              "value": "stars",
              "description": "Sort field: stars, forks, or updated"
            },
            {
              "key": "direction",
              "value": "DESC",
              "description": "Sort direction: DESC or ASC"
            },
            {
              "key": "page",
              "value": "0",
              "description": "Page number (0-indexed)"
            },
            {
              "key": "size",
              "value": "10",
              "description": "Page size"
            }
          ]
        },
        "description": "2. Retrieves stored repositories from PostgreSQL with optional filtering (language, minStars, search), sorting (stars, forks, updated), and pagination."
      },
      "response": []
    }
  ]
}
